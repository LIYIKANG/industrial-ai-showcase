# EFESO Operations AI Workbench - environment template
#
# Copy to .env and edit the values you want to override.  The backend reads
# these via os.getenv at startup time (see backend/services/llm_client.py).
# .env files are never committed; .env.example is the contract.

# ---------- Ollama (local LLM, default provider) ----------

# Base URL of the Ollama daemon.  Default is the standard local install.
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Default model for AI ontology extraction when none is selected in the UI.
OLLAMA_MODEL=qwen2.5:7b

# Chat completion timeout (seconds).  Local models on CPU can be slow.
OLLAMA_TIMEOUT=300

# Status probe timeout (seconds) for the model-list ping on the UI.
OLLAMA_STATUS_TIMEOUT=8

# ---------- DeepSeek (cloud LLM, opt-in) ----------

# Base URL of the DeepSeek OpenAI-compatible endpoint.
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Default DeepSeek chat model.
DEEPSEEK_MODEL=deepseek-chat

# Paste your key here for local testing.  In normal use, the UI captures the
# key in the browser session and never writes it to disk.
DEEPSEEK_API_KEY=

# Chat completion timeout (seconds).
DEEPSEEK_TIMEOUT=180

# Status probe timeout (seconds).
DEEPSEEK_STATUS_TIMEOUT=8
