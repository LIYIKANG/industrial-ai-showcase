# ============================================================
# .env.example — 环境变量模板
# 使用方法：
#   本地开发：cp .env.example .env  然后填入真实值
#   服务器端：cp .env.example .env.production  然后填入真实值
# 注意：.env 和 .env.production 均不提交到 git
# ============================================================

# ── 运行环境 ─────────────────────────────────────────────────
# development（本地） / production（服务器）
APP_ENV=development

# ── Claude AI ────────────────────────────────────────────────
# 必填：Anthropic API Key（从 https://console.anthropic.com 获取）
CLAUDE_API_KEY=
# 可选：使用的模型（默认 claude-sonnet-4-6）
# CLAUDE_MODEL=claude-sonnet-4-6
# Claude API 同時呼び出し数の上限（レート制限対策、デフォルト 2）
# Anthropic の TPM 上限に応じて調整。Tier 引き上げ後は増やしてよい。
# CLAUDE_CONCURRENCY=2

# ── 服务器 ───────────────────────────────────────────────────
# 本地开发保持默认即可；服务器端 Gunicorn 会覆盖这里的设置
# HOST=127.0.0.1
# PORT=9000

# ── CORS ─────────────────────────────────────────────────────
# 本地开发可以用 * 全开
# 生产环境必须改为你的实际域名，多个域名用英文逗号分隔
# CORS_ORIGINS=*
# CORS_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# ── 文件存储 ──────────────────────────────────────────────────
# 生成的 Excel 文件的存放目录（相对项目根目录，或填绝对路径）
# 本地默认：output/
# 服务器推荐：/var/www/pdf-analyzer/output
# OUTPUT_DIR=output

# ── 客户关键词系统 ─────────────────────────────────────────────
# 客户关键词配置文件（相对项目根目录或绝对路径）
# 默认：config/customer_keywords.json
# CUSTOMER_KEYWORD_CONFIG_PATH=config/customer_keywords.json

# 客户产品初始种子数据；本地 SQLite 首次使用且表为空时导入
# 默认：data/customer_product_database_seed.json
# CUSTOMER_PRODUCT_SEED_FILE=data/customer_product_database_seed.json

# 客户关键词结果 Excel 导出目录
# 默认：output/customer_exports
# 服务器推荐：/var/www/pdf-analyzer/output/customer_exports
# CUSTOMER_EXPORT_DIR=output/customer_exports

# 单批最多上传文件数
# CUSTOMER_MAX_UPLOAD_FILES=20

# 客户文件队列同时处理上限；建议生产初期保持 2
# CUSTOMER_MAX_CONCURRENT_JOBS=2

# 前端队列状态轮询间隔（秒）
# CUSTOMER_POLL_INTERVAL_SECONDS=2

# ── 日志 ─────────────────────────────────────────────────────
# DEBUG（开发调试）/ INFO（正常运行）/ WARNING / ERROR
# LOG_LEVEL=INFO

# ── 上传限制 ──────────────────────────────────────────────────
# 单次上传最大文件大小（MB）
# MAX_FILE_SIZE_MB=50

# ── 认证・JWT ─────────────────────────────────────────────────
# 必填：随机生成的密钥，32字节以上
# 生成方法：python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=

# 可选：Token 有效期（默认：访问15分钟 / 刷新7天）
# JWT_ACCESS_EXPIRE_MINUTES=15
# JWT_REFRESH_EXPIRE_DAYS=7

# ── 数据库 ────────────────────────────────────────────────────
# 本地开发（SQLite，零配置）：
# DATABASE_URL=sqlite:///./data/app.db  ← 默认值，不填也可以
# 生产环境（PostgreSQL）：
# DATABASE_URL=postgresql://user:password@localhost/pdf_analyzer

# ── 初始管理员（仅 init_db.py 使用） ──────────────────────────
INIT_ADMIN_USERNAME=admin
INIT_ADMIN_PASSWORD=
# INIT_ADMIN_DISPLAY_NAME=システム管理者

# ── 登录安全 ──────────────────────────────────────────────────
# MAX_LOGIN_ATTEMPTS=5
# LOGIN_LOCKOUT_MINUTES=15

# ── Beta ページ：テンプレートアップロード ──────────────────────
# ユーザーアップロードテンプレートの保存先（相対 or 絶対パス）
# 本地默认：data/user_templates/
# 服务器推荐：/var/www/pdf-analyzer/data/user_templates
# TEMPLATE_UPLOAD_DIR=data/user_templates
# テンプレートファイルの最大サイズ（MB）
# MAX_TEMPLATE_SIZE_MB=10

# ── Stripe 決済（Phase 1: サブスク） ───────────────────────────
# 未設定でもアプリは起動可能。決済機能を使う場合のみ必須。
# テストキーは https://dashboard.stripe.com/test/apikeys から取得
# STRIPE_SECRET_KEY=sk_test_xxx
# STRIPE_PUBLISHABLE_KEY=pk_test_xxx
# Webhook 署名シークレット（stripe listen または Dashboard の Webhook 設定から）
# STRIPE_WEBHOOK_SECRET=whsec_xxx
# Checkout / Portal の戻り先ベース URL（末尾スラッシュ無し）
# APP_BASE_URL=http://localhost:9000
# 各プランの Stripe Price ID（Dashboard で月額 Price を作成して設定）
# STRIPE_PRICE_BASIC=price_xxx
# STRIPE_PRICE_STANDARD=price_xxx
# STRIPE_PRICE_PRO=price_xxx
# STRIPE_PRICE_FLAGSHIP=price_xxx
