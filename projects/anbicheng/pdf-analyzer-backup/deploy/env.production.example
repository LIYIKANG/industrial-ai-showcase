APP_ENV=production

# Required secrets. Put real values only on the server.
CLAUDE_API_KEY=replace-with-anthropic-api-key
JWT_SECRET=replace-with-random-64-hex-string

# Initial admin, used by scripts/init_db.py only.
INIT_ADMIN_USERNAME=admin
INIT_ADMIN_PASSWORD=replace-with-strong-password
INIT_ADMIN_DISPLAY_NAME=Admin

# Runtime.
CLAUDE_MODEL=claude-sonnet-4-6
CLAUDE_CONCURRENCY=2
LOG_LEVEL=INFO
MAX_FILE_SIZE_MB=50

# Public URL and CORS.
APP_BASE_URL=https://your-domain.example
CORS_ORIGINS=https://your-domain.example

# SQLite is fine for a small team. Switch to PostgreSQL by replacing this URL.
DATABASE_URL=sqlite:////var/www/pdf-analyzer/data/app.db

# Writable storage paths.
OUTPUT_DIR=/var/www/pdf-analyzer/output
CUSTOMER_EXPORT_DIR=/var/www/pdf-analyzer/output/customer_exports
TEMPLATE_UPLOAD_DIR=/var/www/pdf-analyzer/data/user_templates
CUSTOMER_KEYWORD_CONFIG_PATH=config/customer_keywords.json
CUSTOMER_PRODUCT_SEED_FILE=data/customer_product_database_seed.json
CUSTOMER_MAX_UPLOAD_FILES=20
CUSTOMER_MAX_CONCURRENT_JOBS=2
CUSTOMER_POLL_INTERVAL_SECONDS=2

# Stripe is optional. Leave empty if billing is not enabled yet.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_BASIC=
STRIPE_PRICE_STANDARD=
STRIPE_PRICE_PRO=
STRIPE_PRICE_FLAGSHIP=
